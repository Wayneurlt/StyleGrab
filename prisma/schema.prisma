// StyleGrab database schema.
//
// Conventions
// - Money is stored as integer minor units (e.g. KES cents) in `Int` columns. See docs/ARCHITECTURE.md.
// - Historical rows (orders, payments, movements, audit events) are never hard-deleted; catalogue rows are archived.
// - Inventory invariants are additionally enforced by CHECK constraints and triggers in the migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity, access control
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  @@index([roleId])
}

/// Server-side sessions for both staff users and customer accounts. Only a SHA-256 hash of the token is stored.
model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  userAgent  String?
  ip         String?

  @@index([userId])
  @@index([customerId])
  @@index([expiresAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Gap-free-ish document number counters (order numbers, PO numbers, ...). Incremented with a row lock.
model Counter {
  key   String @id
  value Int    @default(0)
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Category {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  code        String              @unique // short code used in SKU generation, e.g. "SC"
  description String?
  imageKey    String?
  parentId    String?
  parent      Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]          @relation("CategoryTree")
  isVisible   Boolean             @default(true)
  isArchived  Boolean             @default(false)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  attributes  CategoryAttribute[]
  products    Product[]

  @@index([parentId, sortOrder])
}

/// Defines which variant attributes apply to a category (e.g. "Size" for Shoes, "Material" for Scarves).
/// Child categories inherit their ancestors' attributes.
model CategoryAttribute {
  id         String    @id @default(cuid())
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  code       String // stable machine key, e.g. "size"
  options    String[] // allowed values; empty = free text
  isRequired Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  @@unique([categoryId, code])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id              String           @id @default(cuid())
  code            String           @unique // e.g. "SC-001", used as SKU stem
  name            String
  slug            String           @unique
  description     String           @default("")
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand           String?
  price           Int // default selling price, minor units
  costPrice       Int? // default unit cost estimate, minor units
  status          ProductStatus    @default(DRAFT)
  isFeatured      Boolean          @default(false)
  seoTitle        String?
  seoDescription  String?
  searchText      String           @default("") // denormalised: name, brand, SKUs, barcodes, attribute values
  createdById     String?
  updatedById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  publishedAt     DateTime?
  images          ProductImage[]
  variants        ProductVariant[]

  @@index([status, categoryId])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_searchText_trgm")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String   @unique // object-storage key
  alt       String   @default("")
  width     Int?
  height    Int?
  mimeType  String
  sizeBytes Int
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model ProductVariant {
  id          String                  @id @default(cuid())
  productId   String
  product     Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku         String                  @unique
  barcode     String?                 @unique
  title       String // e.g. "Black / 38"
  price       Int? // override of product price
  costPrice   Int? // default unit cost estimate for this variant
  isArchived  Boolean                 @default(false)
  sortOrder   Int                     @default(0)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  attributes  VariantAttributeValue[]
  inventory   InventoryBalance?
  movements   InventoryMovement[]
  orderItems  OrderItem[]

  @@index([productId])
}

model VariantAttributeValue {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  value     String

  @@unique([variantId, code])
  @@index([code, value])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

/// One balance row per variant (single location for this release).
/// available = onHand - reserved. Enforced by CHECK constraints (onHand >= 0, 0 <= reserved <= onHand).
model InventoryBalance {
  variantId         String         @id
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  onHand            Int            @default(0)
  reserved          Int            @default(0)
  lowStockThreshold Int            @default(3)
  /// Weighted-average unit cost of the on-hand stock, minor units. Null until a cost is known.
  avgCost           Int?
  updatedAt         DateTime       @updatedAt

  @@index([onHand])
}

enum MovementType {
  OPENING_STOCK
  PURCHASE_RECEIPT
  SALE
  RETURN_TO_STOCK
  DAMAGE
  LOSS
  ADJUSTMENT
  COUNT_ADJUSTMENT
  RESERVATION
  RESERVATION_RELEASE
}

/// Append-only stock ledger. UPDATE/DELETE are blocked by a trigger. Corrections are compensating rows.
model InventoryMovement {
  id             String         @id @default(cuid())
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  type           MovementType
  /// Change to on-hand quantity (signed).
  qtyOnHand      Int            @default(0)
  /// Change to reserved quantity (signed).
  qtyReserved    Int            @default(0)
  onHandAfter    Int
  reservedAfter  Int
  unitCost       Int?
  reason         String?
  notes          String?
  referenceType  String? // "order", "goods_receipt", "adjustment", "stocktake", "return", "import"
  referenceId    String?
  referenceLabel String? // human readable number, e.g. SG-10023
  /// Uniqueness key that makes each logical stock effect idempotent (e.g. "SALE:orderItem:<id>").
  dedupeKey      String?        @unique
  userId         String?
  createdAt      DateTime       @default(now())

  @@index([variantId, createdAt])
  @@index([type, createdAt])
  @@index([referenceType, referenceId])
}

enum AdjustmentStatus {
  PENDING_APPROVAL
  APPLIED
  REJECTED
}

enum AdjustmentReason {
  OPENING_STOCK
  COUNT_DISCREPANCY
  DAMAGE
  LOSS
  DATA_CORRECTION
  OTHER
}

model StockAdjustment {
  id           String                @id @default(cuid())
  number       String                @unique
  reason       AdjustmentReason
  status       AdjustmentStatus
  notes        String?
  createdById  String
  approvedById String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime              @default(now())
  items        StockAdjustmentItem[]

  @@index([status, createdAt])
}

model StockAdjustmentItem {
  id           String          @id @default(cuid())
  adjustmentId String
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  variantId    String
  qtyChange    Int
  unitCost     Int?

  @@unique([adjustmentId, variantId])
}

enum StocktakeStatus {
  IN_PROGRESS
  SUBMITTED
  FINALIZED
  CANCELLED
}

model Stocktake {
  id            String          @id @default(cuid())
  number        String          @unique
  name          String
  status        StocktakeStatus @default(IN_PROGRESS)
  notes         String?
  categoryId    String?
  startedById   String
  submittedById String?
  finalizedById String?
  startedAt     DateTime        @default(now())
  submittedAt   DateTime?
  finalizedAt   DateTime?
  items         StocktakeItem[]
}

model StocktakeItem {
  id          String    @id @default(cuid())
  stocktakeId String
  stocktake   Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  variantId   String
  /// On-hand snapshot when the count started. Adjustment = counted - expected, so sales during the count are preserved.
  expectedQty Int
  countedQty  Int?
  countedAt   DateTime?
  countedById String?

  @@unique([stocktakeId, variantId])
}

// ---------------------------------------------------------------------------
// Purchasing
// ---------------------------------------------------------------------------

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
  receipts       GoodsReceipt[]

  @@index([name])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  number           String              @unique
  supplierId       String
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status           PurchaseOrderStatus @default(DRAFT)
  expectedAt       DateTime?
  notes            String?
  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  items            PurchaseOrderItem[]
  receipts         GoodsReceipt[]

  @@index([status, createdAt])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId       String
  orderedQty      Int
  receivedQty     Int           @default(0)
  unitCost        Int

  @@unique([purchaseOrderId, variantId])
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  number          String             @unique
  supplierId      String?
  supplier        Supplier?          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  reference       String? // supplier invoice / delivery note
  receivedAt      DateTime
  notes           String?
  receivedById    String
  idempotencyKey  String             @unique
  createdAt       DateTime           @default(now())
  items           GoodsReceiptItem[]

  @@index([receivedAt])
}

model GoodsReceiptItem {
  id          String       @id @default(cuid())
  receiptId   String
  receipt     GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  variantId   String
  receivedQty Int
  acceptedQty Int
  damagedQty  Int          @default(0)
  unitCost    Int
  notes       String?
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id           String    @id @default(cuid())
  name         String
  phone        String?   @unique // normalised E.164-ish digits
  email        String?   @unique
  passwordHash String?
  notes        String? // staff-only
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]
  sessions     Session[]

  @@index([name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_name_trgm")
}

// ---------------------------------------------------------------------------
// Orders, sales, payments, returns
// ---------------------------------------------------------------------------

enum SalesChannel {
  WEBSITE
  POS
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  PHONE
  OTHER
}

/// Fulfilment lifecycle — deliberately independent from payment status.
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  AWAITING_CONFIRMATION
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum FulfilmentType {
  IN_STORE
  PICKUP
  DELIVERY
}

/// A single model for every sale, regardless of channel. A POS sale is an Order created directly as COMPLETED.
model Order {
  id                String         @id @default(cuid())
  number            String         @unique
  channel           SalesChannel
  status            OrderStatus    @default(PENDING)
  paymentStatus     PaymentStatus  @default(UNPAID)
  fulfilmentType    FulfilmentType @default(IN_STORE)
  customerId        String?
  customer          Customer?      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Contact snapshot (guest checkout / walk-in)
  contactName       String?
  contactPhone      String?
  contactEmail      String?
  shippingAddress   String?
  customerNote      String?
  internalNote      String?
  subtotal          Int
  discountTotal     Int            @default(0)
  total             Int
  /// Sum of CONFIRMED payments (before refunds) — maintained by the payment service.
  amountPaid        Int            @default(0)
  /// Sum of payments still awaiting staff verification.
  amountPending     Int            @default(0)
  amountRefunded    Int            @default(0)
  /// Value of goods returned against this order (reduces the amount due).
  amountReturned    Int            @default(0)
  orderDiscountType String? // "FIXED" | "PERCENT"
  orderDiscountValue Int? // minor units or basis points
  idempotencyKey    String         @unique
  createdById       String?
  assignedToId      String?
  shiftId           String?
  shift             PosShift?      @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  exchangeFromReturnId String?     @unique
  reservationExpiresAt DateTime?
  placedAt          DateTime       @default(now())
  confirmedAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  updatedAt         DateTime       @updatedAt
  items             OrderItem[]
  payments          PaymentRecord[]
  returns           Return[]
  statusHistory     OrderStatusEvent[]

  @@index([channel, placedAt])
  @@index([status, placedAt])
  @@index([paymentStatus])
  @@index([customerId])
  @@index([completedAt])
  @@index([reservationExpiresAt])
}

model OrderItem {
  id            String         @id @default(cuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  // Snapshots — never read current catalogue rows to reconstruct a receipt.
  productId     String
  productName   String
  variantTitle  String
  sku           String
  quantity      Int
  unitPrice     Int
  /// Original catalogue price when a price override was applied.
  listPrice     Int
  lineDiscount  Int            @default(0)
  /// Share of the order-level discount allocated to this line.
  orderDiscountShare Int       @default(0)
  lineTotal     Int // quantity * unitPrice - lineDiscount - orderDiscountShare
  /// Weighted-average unit cost at the moment stock was deducted. Null if unknown.
  unitCost      Int?
  returnedQty   Int            @default(0)
  returnItems   ReturnItem[]

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusEvent {
  id         String      @id @default(cuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  userId     String?
  createdAt  DateTime    @default(now())

  @@index([orderId, createdAt])
}

enum PaymentMethodType {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CARD_TERMINAL
  EXCHANGE_CREDIT
  OTHER
}

/// Configurable ways customers pay *outside* StyleGrab (no gateway integration).
model PaymentMethod {
  id                   String            @id @default(cuid())
  code                 String            @unique
  name                 String
  type                 PaymentMethodType
  requiresReference    Boolean           @default(false)
  /// When true, recorded payments start as PENDING_CONFIRMATION until a permitted user verifies them.
  requiresVerification Boolean           @default(false)
  instructions         String? // shown at checkout, e.g. till number
  isActive             Boolean           @default(true)
  isSystem             Boolean           @default(false)
  sortOrder            Int               @default(0)
  payments             PaymentRecord[]
  refunds              Refund[]
}

enum PaymentRecordStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  FAILED
  VOIDED
}

model PaymentRecord {
  id              String              @id @default(cuid())
  orderId         String
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  methodId        String
  method          PaymentMethod       @relation(fields: [methodId], references: [id], onDelete: Restrict)
  amount          Int
  /// Cash handed over (for change calculation). amount <= tendered.
  tendered        Int?
  status          PaymentRecordStatus
  /// External reference, upper-cased & trimmed (e.g. M-Pesa code). Unique per method.
  reference       String?
  notes           String?
  receivedAt      DateTime            @default(now())
  recordedById    String?
  verifiedById    String?
  verifiedAt      DateTime?
  verificationNote String?
  shiftId         String?
  shift           PosShift?           @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  idempotencyKey  String?             @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // A partial unique index on (methodId, reference) for PENDING_CONFIRMATION/CONFIRMED rows lives in migration SQL.
  @@index([methodId, reference])
  @@index([orderId])
  @@index([status, receivedAt])
  @@index([shiftId])
}

enum ReturnItemCondition {
  SALEABLE
  DAMAGED
  NEEDS_INSPECTION
}

enum ReturnResolution {
  REFUND
  EXCHANGE
  NO_REFUND
}

model Return {
  id             String           @id @default(cuid())
  number         String           @unique
  orderId        String
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reason         String
  resolution     ReturnResolution
  /// Value of returned goods (sum of returned share of line totals).
  creditAmount   Int
  notes          String?
  createdById    String
  idempotencyKey String           @unique
  createdAt      DateTime         @default(now())
  items          ReturnItem[]
  refunds        Refund[]

  @@index([orderId])
  @@index([createdAt])
}

model ReturnItem {
  id            String              @id @default(cuid())
  returnId      String
  return        Return              @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId   String
  orderItem     OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity      Int
  condition     ReturnItemCondition
  creditAmount  Int
  /// True once the units were put back into sellable stock.
  restocked     Boolean             @default(false)
  /// For NEEDS_INSPECTION: final decision.
  resolvedAt    DateTime?
  resolvedById  String?
}

model Refund {
  id           String        @id @default(cuid())
  returnId     String?
  return       Return?       @relation(fields: [returnId], references: [id], onDelete: Restrict)
  orderId      String
  methodId     String
  method       PaymentMethod @relation(fields: [methodId], references: [id], onDelete: Restrict)
  amount       Int
  reference    String?
  notes        String?
  shiftId      String?
  shift        PosShift?     @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  recordedById String
  createdAt    DateTime      @default(now())

  @@index([orderId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// POS registers and cash shifts
// ---------------------------------------------------------------------------

model PosRegister {
  id        String     @id @default(cuid())
  name      String     @unique
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  shifts    PosShift[]
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model PosShift {
  id              String          @id @default(cuid())
  registerId      String
  register        PosRegister     @relation(fields: [registerId], references: [id], onDelete: Restrict)
  /// Partial unique index (one OPEN shift per register) is added in migration SQL.
  status          ShiftStatus     @default(OPEN)
  openedById      String
  closedById      String?
  openingCash     Int
  expectedCash    Int?
  countedCash     Int?
  difference      Int?
  closingNotes    String?
  openedAt        DateTime        @default(now())
  closedAt        DateTime?
  cashMovements   CashMovement[]
  payments        PaymentRecord[]
  refunds         Refund[]
  orders          Order[]

  @@index([registerId, status])
}

enum CashMovementType {
  PAY_IN
  PAY_OUT
}

model CashMovement {
  id           String           @id @default(cuid())
  shiftId      String
  shift        PosShift         @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  type         CashMovementType
  amount       Int
  reason       String
  recordedById String
  createdAt    DateTime         @default(now())
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only. UPDATE/DELETE are blocked by a trigger.
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actorLabel String?
  action     String // e.g. "product.update", "payment.verify"
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}
