# --- Database (PostgreSQL) -------------------------------------------------
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&connect_timeout=30"
# Direct (non-pooled) connection used by `prisma migrate`. Same as DATABASE_URL when not using a pooler.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&connect_timeout=30"

# --- App --------------------------------------------------------------------
# Public base URL (canonical links, product metadata).
NUXT_PUBLIC_SITE_URL="https://shop.example.com"
# Directory for uploaded images (must be persistent storage in production).
UPLOAD_DIR="./storage/uploads"
# Max upload size in bytes (default 5 MB).
UPLOAD_MAX_BYTES="5242880"
# Set to "true" only when running behind a trusted reverse proxy that sets X-Forwarded-For / X-Forwarded-Host.
TRUST_PROXY="false"
# Set to "off" to disable the in-process 5-minute reservation-expiry sweep.
RESERVATION_SWEEP="on"

# --- Seeding (first run only) ------------------------------------------------
SEED_OWNER_EMAIL="owner@example.com"
# Leave empty to have the seed generate one and print it once.
SEED_OWNER_PASSWORD=""
SEED_OWNER_NAME="Owner"
# Development only: create demo products and opening stock.
SEED_DEMO_DATA="false"
